{
  "description": "Muat aturan Bahasa Sederhana secara otomatis untuk setiap sesi Codex.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"${PLUGIN_ROOT}\" ] && node \"${PLUGIN_ROOT}/src/hooks/bahasa-sederhana-activate.js\" || true",
            "timeout": 5,
            "statusMessage": "Memuat Bahasa Sederhana...",
            "additionalContextLimit": 0
          }
        ]
      }
    ]
  }
}
